    "definitions": [
      {
        "code": "payment_amount",
        "revision": 1,
        "type": "METRIC",
        "name": "支付金额",
        "description": "支付状态为1，按支付时间统计实付金额，分换算元",
        "aliases": [
          "实收金额"
        ],
        "retrieval": {
          "queryExpressions": [
            "实际收到多少钱"
          ],
          "queryContexts": [
            "统计已支付订单，以元显示"
          ]
        },
        "specification": {
          "expression": {
            "op": "divide",
            "left": {
              "op": "sum",
              "arg": {
                "attribute": "amount"
              }
            },
            "right": {
              "literal": 100
            },
            "onZero": "null"
          },
          "filters": [
            {
              "attribute": "state",
              "operator": "eq",
              "value": 1
            }
          ],
          "timeAttribute": "time",
          "unit": "元",
          "valueRange": {
            "minimum": 0,
            "minimumInclusive": true
          },
          "parameters": [
            {
              "code": "identity",
              "dataType": "integer"
            },
            {
              "code": "amount",
              "dataType": "integer"
            },
            {
              "code": "time",
              "dataType": "datetime"
            },
            {
              "code": "state",
              "dataType": "integer"
            }
          ],
          "grainKeys": [
            "identity"
          ]
        }
      },
      {
        "code": "state_concept",
        "revision": 1,
        "type": "DIMENSION",
        "name": "付款状态",
        "description": "状态编码角色由模型绑定明确，不意味着两个模型可连接",
        "aliases": [
          "结算状态"
        ],
        "specification": {
          "parameters": [
            {
              "code": "state",
              "dataType": "integer"
            }
          ],
          "attribute": "state"
        }
      },
