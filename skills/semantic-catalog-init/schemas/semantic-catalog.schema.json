{
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": "1.0"
    },
    "sourceSchemaFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "catalog": {
      "type": "object",
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          },
          "minItems": 1
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          },
          "minItems": 0
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimension"
          },
          "minItems": 0
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          },
          "minItems": 0
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 0
        }
      },
      "required": [
        "entities",
        "metrics",
        "dimensions",
        "relationships",
        "rules"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "unresolvedIssues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "minItems": 0
    }
  },
  "required": [
    "formatVersion",
    "sourceSchemaFingerprint",
    "catalog",
    "evidence",
    "unresolvedIssues"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "column": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "column": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "column"
      ],
      "additionalProperties": false
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "operator": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "attribute",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "operator": {
              "enum": [
                "in",
                "not_in"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "attribute",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "operator": {
              "enum": [
                "is_null",
                "is_not_null"
              ]
            }
          },
          "required": [
            "attribute",
            "operator"
          ],
          "additionalProperties": false
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "attribute"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "metric": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "metric"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": "number"
            }
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "sum",
                "avg",
                "min",
                "max",
                "count_distinct"
              ]
            },
            "arg": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "arg"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "count_rows"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "add",
                "subtract",
                "multiply"
              ]
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "divide"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            },
            "onZero": {
              "const": "null"
            }
          },
          "required": [
            "op",
            "left",
            "right",
            "onZero"
          ],
          "additionalProperties": false
        }
      ]
    },
    "attribute": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mapping": {
          "$ref": "#/$defs/column"
        },
        "dataType": {
          "enum": [
            "integer",
            "decimal",
            "string",
            "boolean",
            "date",
            "datetime"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "enumValues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "code",
        "name",
        "description",
        "mapping",
        "dataType"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "grain": {
          "type": "string",
          "minLength": 1
        },
        "primaryKey": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "tables": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "alias": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "datasource": {
                    "type": "string",
                    "minLength": 1
                  },
                  "schema": {
                    "type": "string",
                    "minLength": 1
                  },
                  "table": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "alias",
                  "datasource",
                  "schema",
                  "table"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "base": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "joins": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "left",
                      "inner"
                    ]
                  },
                  "right": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "on": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "left": {
                          "$ref": "#/$defs/column"
                        },
                        "right": {
                          "$ref": "#/$defs/column"
                        }
                      },
                      "required": [
                        "left",
                        "right"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "type",
                  "right",
                  "on"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": [
            "tables",
            "base",
            "joins"
          ],
          "additionalProperties": false
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute"
          },
          "minItems": 1
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          },
          "minItems": 0
        }
      },
      "required": [
        "code",
        "name",
        "description",
        "grain",
        "primaryKey",
        "source",
        "attributes",
        "filters"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          },
          "minItems": 0
        },
        "timeAttribute": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "name",
        "description",
        "entity",
        "expression",
        "filters",
        "timeAttribute",
        "unit"
      ],
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "attribute": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "name",
        "entity",
        "attribute",
        "description"
      ],
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fromEntity": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "toEntity": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "cardinality": {
          "enum": [
            "one_to_one",
            "many_to_one",
            "one_to_many"
          ]
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "code",
        "name",
        "fromEntity",
        "toEntity",
        "cardinality",
        "pairs"
      ],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "entity": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "attribute": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "const": "range"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      },
      "required": [
        "code",
        "entity",
        "attribute",
        "kind",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "document",
            "user_confirmation",
            "schema"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target",
        "kind",
        "source",
        "location",
        "statement"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "target",
        "question",
        "blocking"
      ],
      "additionalProperties": false
    }
  }
}
