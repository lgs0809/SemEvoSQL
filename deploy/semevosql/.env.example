# SemEvoSQL deployment configuration.
# Copy this file to deploy/semevosql/.env and fill every required blank value.
# Do not commit the resulting .env file.

SEMEVOSQL_COMPOSE_PROJECT_NAME=semevosql
SEMEVOSQL_METADATA_PORT=33306
SEMEVOSQL_BACKEND_PORT=28065
SEMEVOSQL_FRONTEND_PORT=23000
SEMEVOSQL_BIND_HOST=127.0.0.1

SEMEVOSQL_METADATA_DATABASE=semevosql
SEMEVOSQL_METADATA_USER=semevosql
SEMEVOSQL_METADATA_PASSWORD=
SEMEVOSQL_METADATA_VOLUME=semevosql-metadata-pg16
SEMEVOSQL_UPLOADS_VOLUME=semevosql-uploads
SEMEVOSQL_NETWORK_NAME=semevosql-net

# Required: generate independent random values before first start.
SEMEVOSQL_EXECUTION_INTERNAL_TOKEN=
SEMEVOSQL_SECRET_ENCRYPTION_KEY=

# SemEvoSQL 1.0 is self-hosted single-user by default. Keep the Web Console on loopback unless you deliberately add a trusted external access layer.
SEMEVOSQL_SPRING_PROFILE=standalone
SEMEVOSQL_MCP_ENABLED=true
SEMEVOSQL_MCP_PUBLIC_BASE_URL=http://127.0.0.1:28065

# Optional application image overrides.
SEMEVOSQL_BACKEND_IMAGE=semevosql/backend:local
SEMEVOSQL_FRONTEND_IMAGE=semevosql/frontend:local
